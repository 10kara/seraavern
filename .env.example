VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Подходит любое из двух имён переменных:
# VITE_SUPABASE_PUBLISHABLE_KEY или VITE_SUPABASE_ANON_KEY.
# Это публичный (anon/publishable) ключ, НЕ service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Не пароль. Только email пользователя Supabase, которому разрешён вход в админку.
VITE_ADMIN_EMAIL=tenkara@jedi-archives.local

VITE_SUPABASE_STORAGE_BUCKET=archive
